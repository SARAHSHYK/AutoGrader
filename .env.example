# --- Local model (free, offline, no key) -----------------------------------
# Used by the llm_review analyzer (readability) and for failure hints. The
# rules file names the model it wants; if that model isn't pulled, this one
# is used instead and the report says so.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
PORT=8788

# --- Toolchain (leave blank to use whatever is on PATH) -------------------
CC=
CPPCHECK=
GCOV=
